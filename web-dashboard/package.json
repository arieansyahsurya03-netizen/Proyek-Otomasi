{
  "name": "penyiraman-otomatis",
  "version": "1.0.0",
  "description": "Web Dashboard untuk Sistem Penyiraman Otomatis dengan ESP32",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:be": "tsx watch src/index.ts",
    "dev:fe": "vite",
    "build:fe": "vite build",
    "build:be": "tsc",
    "build": "vite build && tsc",
    "start": "node dist/index.js",
    "clean": "node -e \"const fs=require('fs');['dist','node_modules','package-lock.json'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch(e){}})\""
  },
  "keywords": ["dashboard", "monitoring", "penyiraman", "esp32"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/cors": "^2.8.13",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitejs/plugin-react": "^4.0.1",
    "typescript": "^5.1.3",
    "tsx": "^4.19.0",
    "vite": "^4.3.9"
  }
}
